# ---- build output ----
target/
*.class
*.jar
*.war

# ---- packaging ----
package/

# ---- native / runtime images ----
# 只忽略仓库根下的 runtime/（jlink 产物）；不要写成 runtime/，
# 那会连 secs-runtime 模块的 Java 源码一起忽略掉。
/runtime/

# ---- native image ----
*.aot
*.hprof

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp

# ---- frontend ----
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.pnpm-store/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# ---- local state & logs ----
logs/
*.log
sessions/
*.jsonl

# ---- OS ----
*.DS_Store
Thumbs.db

# ---- 本地工作区状态 ----
.workbuddy/
.box-agent/
.box-agent-scratch/
.github

# ---- 版权标准 PDF（SEMI 付费文档，不入库） ----
docs/reference/pdf/

# ---- 工具缓存（内容只有 retain_for_chat 之类，不是源码） ----
*.artifact.json
