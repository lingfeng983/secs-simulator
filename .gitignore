# ---- build output ----
target/
*.class
*.jar
*.war

# ---- 安装包与运行产物 ----
# 安装包统一收到 scripts/out/（scripts/package.ps1 产出）
/scripts/out/
# 历史产物目录，保留忽略以防旧脚本残留
/build/
package/

# ---- native / runtime images ----
# 只忽略仓库根下的 runtime/（jlink 产物）；不要写成 runtime/，
# 那会连 secs-simulator-service/secs-runtime 模块的 Java 源码一起忽略掉。
/runtime/

# ---- native image ----
*.aot
*.hprof

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp

# ---- 前端（secs-simulator-ui）----
node_modules/
dist/
.pnpm-store/
secs-simulator-ui/test-results/
secs-simulator-ui/playwright-report/
secs-simulator-ui/blob-report/
# 本地截图（人工/临时 Playwright 脚本产出，不是源码）
secs-simulator-ui/shots/

# ---- local state & logs ----
logs/
*.log
sessions/
*.jsonl

# ---- OS ----
*.DS_Store
Thumbs.db

# ---- 本地工作区状态 ----
.workbuddy/
.box-agent/
.box-agent-scratch/

# ---- 版权标准 PDF（SEMI 付费文档，不入库） ----
docs/reference/pdf/

# ---- 工具缓存（内容只有 retain_for_chat 之类，不是源码） ----
*.artifact.json

# ---- Tauri 桌面壳构建产物 ----
# resources/ 由 scripts/package.ps1 在构建时填充（原生 exe），不是源码
secs-simulator-gui/src-tauri/resources/
secs-simulator-gui/src-tauri/gen/
secs-simulator-gui/src-tauri/target/

# ---- 第三方工具本地状态 ----
.freebuff/
# 旧版实机脚本的临时工作目录；现已改用 build/run 与系统临时目录
/test-run/

# ---- 会话工具临时目录(本地状态,不入库) ----
.zcode/
secs-simulator-ui/.pw-tmp/
