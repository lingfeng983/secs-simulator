# ---- build output ----
target/
*.class
*.jar
*.war

# ---- 安装包与运行产物（统一收到 build/：installer / run / native）----
/build/
# 历史产物目录，保留忽略以防旧脚本残留
package/

# ---- native / runtime images ----
# 只忽略仓库根下的 runtime/（jlink 产物）；不要写成 runtime/，
# 那会连 secs-runtime 模块的 Java 源码一起忽略掉。
/runtime/

# ---- native image ----
*.aot
*.hprof

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp

# ---- frontend ----
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.pnpm-store/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
# 本地截图（人工/临时 Playwright 脚本产出，不是源码）
frontend/shots/

# ---- local state & logs ----
logs/
*.log
sessions/
*.jsonl

# ---- OS ----
*.DS_Store
Thumbs.db

# ---- 本地工作区状态 ----
.workbuddy/
.box-agent/
.box-agent-scratch/

# ---- 版权标准 PDF（SEMI 付费文档，不入库） ----
docs/reference/pdf/

# ---- 工具缓存（内容只有 retain_for_chat 之类，不是源码） ----
*.artifact.json

# ---- Tauri 桌面壳构建产物 ----
# resources/ 由 scripts/package-windows.ps1 在构建时填充（原生 exe），不是源码
gui/src-tauri/resources/
gui/src-tauri/gen/
gui/src-tauri/target/

# ---- 第三方工具本地状态 ----
.freebuff/
# 旧版实机脚本的临时工作目录；现已改用 build/run 与系统临时目录
/test-run/
