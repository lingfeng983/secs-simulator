[Unit]
Description=SECS Simulator
Documentation=https://github.com/shimizukenta/secs-simulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secs
Group=secs
WorkingDirectory=/opt/secs-sim
EnvironmentFile=/etc/secs-sim.env
ExecStart=/opt/secs-sim/start-server.sh
Restart=on-failure
RestartSec=3
StateDirectory=secs-sim
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/secs-sim
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
