[
  {
    "id": "temp-constant",
    "name": "恒温保温",
    "description": "恒定 180°C：保温/待机段的稳态温度设定值。",
    "body": "{\"source\":{\"mode\":\"const\",\"value\":180}}"
  },
  {
    "id": "temp-sine",
    "name": "正弦炉温波动",
    "description": "150~350°C、60s 周期：加热-散热平衡下的炉温周期波动。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"sine\",\"min\":150,\"max\":350,\"periodMs\":60000}}}"
  },
  {
    "id": "temp-ramp",
    "name": "工艺升温（斜坡）",
    "description": "20→400°C、5 分钟线性升温：升温段温控曲线，走完停在终点。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"ramp\",\"from\":20,\"to\":400,\"durationMs\":300000}}}"
  },
  {
    "id": "temp-pwl-3seg",
    "name": "升-保-降三段炉温",
    "description": "20→400→保温 10min→50°C：典型退火/氧化炉温程序。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"pwl\",\"points\":[{\"tMs\":0,\"value\":20},{\"tMs\":600000,\"value\":400},{\"tMs\":1200000,\"value\":400},{\"tMs\":1800000,\"value\":50}]}}}"
  },
  {
    "id": "vac-pwl-down",
    "name": "抽真空（pwl 降压）",
    "description": "760→0.01 Torr 两分钟：Loadlock/工艺腔抽真空的典型降压曲线。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"pwl\",\"points\":[{\"tMs\":0,\"value\":760},{\"tMs\":60000,\"value\":5},{\"tMs\":120000,\"value\":0.01}]}}}"
  },
  {
    "id": "vac-uniform",
    "name": "腔压均匀波动",
    "description": "0.5~3.5 Torr、2s 重采样：工艺腔压的随机小波动。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"uniform\",\"min\":0.5,\"max\":3.5,\"resampleMs\":2000}}}"
  },
  {
    "id": "vac-random-walk",
    "name": "基压随机游走",
    "description": "0.5~2 mbar 有界游走、σ=0.05：真空基压的缓慢抖动。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"randomWalk\",\"start\":0.8,\"driftPerSec\":0,\"sigma\":0.05,\"gridMs\":1000,\"octaves\":1,\"min\":0.5,\"max\":2,\"policy\":\"CLAMP\"}}}"
  },
  {
    "id": "flow-uniform",
    "name": "工艺气流均匀波动",
    "description": "100~300 sccm、3s 重采样：MFC 设定流量附近的随机波动。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"uniform\",\"min\":100,\"max\":300,\"resampleMs\":3000}}}"
  },
  {
    "id": "rf-sine",
    "name": "射频功率正弦波动",
    "description": "800~1200W、60s 周期、相位 10s：等离子射频功率的周期波动。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"sine\",\"min\":800,\"max\":1200,\"periodMs\":60000,\"phaseMs\":10000}}}"
  },
  {
    "id": "count-ramp",
    "name": "产量计数（循环爬升）",
    "description": "0→100、60s 一轮循环：班次产量的稳步累积。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"ramp\",\"from\":0,\"to\":100,\"durationMs\":60000,\"cyclic\":true}}}"
  },
  {
    "id": "film-ramp",
    "name": "沉积膜厚（循环爬升）",
    "description": "0→5000Å、2 分钟循环：膜厚累积到目标后清片重来。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"ramp\",\"from\":0,\"to\":5000,\"durationMs\":120000,\"cyclic\":true}}}"
  },
  {
    "id": "seq-etch-chamber-pressure",
    "name": "刻蚀腔压（抽真空→稳压→主刻蚀→破真空）",
    "description": "760→0.02→0.05 Torr：抽真空 15s、稳压 5s、进气 5s、主刻蚀 90s、过刻 30s、破真空 30s，全程 175s。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"sequence\",\"cyclic\":false,\"segments\":[{\"durationMs\":15000,\"curve\":{\"type\":\"ramp\",\"from\":760,\"to\":0.02,\"durationMs\":15000}},{\"durationMs\":5000,\"curve\":{\"type\":\"uniform\",\"min\":0.012,\"max\":0.03,\"resampleMs\":1000}},{\"durationMs\":5000,\"curve\":{\"type\":\"ramp\",\"from\":0.02,\"to\":0.05,\"durationMs\":5000}},{\"durationMs\":90000,\"curve\":{\"type\":\"sine\",\"min\":0.045,\"max\":0.055,\"periodMs\":10000}},{\"durationMs\":30000,\"curve\":{\"type\":\"uniform\",\"min\":0.04,\"max\":0.06,\"resampleMs\":2000}},{\"durationMs\":30000,\"curve\":{\"type\":\"ramp\",\"from\":0.05,\"to\":760,\"durationMs\":30000}}]}}}"
  },
  {
    "id": "seq-pecvd-chamber-temp",
    "name": "PECVD 腔体温度（升温→保温→沉积→降温）",
    "description": "25→400→80°C：升温 60s、保温 30s、沉积 120s 正弦 ±4°C、降温 60s、待机 30s，全程 300s。",
    "body": "{\"source\":{\"mode\":\"curve\",\"clock\":\"phase\",\"curve\":{\"type\":\"sequence\",\"cyclic\":false,\"segments\":[{\"durationMs\":60000,\"curve\":{\"type\":\"ramp\",\"from\":25,\"to\":400,\"durationMs\":60000}},{\"durationMs\":30000,\"curve\":{\"type\":\"constant\",\"value\":400}},{\"durationMs\":120000,\"curve\":{\"type\":\"sine\",\"min\":396,\"max\":404,\"periodMs\":60000}},{\"durationMs\":60000,\"curve\":{\"type\":\"ramp\",\"from\":400,\"to\":80,\"durationMs\":60000}},{\"durationMs\":30000,\"curve\":{\"type\":\"constant\",\"value\":80}}]}}}"
  },
  {
    "id": "combo-thermal-heater",
    "name": "炉温取一位小数（组合）",
    "description": "150~350°C、60s 周期；输出按 0.1 取整——组合模板的最小形态：一条私有曲线 + 一条算式。",
    "body": "{\"source\":{\"mode\":\"expr\",\"clock\":\"phase\",\"vars\":{\"v\":{\"type\":\"sine\",\"min\":150,\"max\":350,\"periodMs\":60000}},\"expr\":\"roundTo(v, 0.1)\"}}"
  },
  {
    "id": "combo-rf-net",
    "name": "射频净功率（组合）",
    "description": "正向 800~1200W 周期波动、反射 2~30W 游走；输出 NET 是净功率。",
    "body": "{\"source\":{\"mode\":\"expr\",\"clock\":\"phase\",\"vars\":{\"fwd\":{\"type\":\"sine\",\"min\":800,\"max\":1200,\"periodMs\":60000,\"phaseMs\":10000},\"ref\":{\"type\":\"randomWalk\",\"start\":5,\"driftPerSec\":0.2,\"sigma\":2,\"gridMs\":1000,\"octaves\":1,\"min\":2,\"max\":30,\"policy\":\"CLAMP\"}},\"expr\":\"fwd - ref\"}}"
  },
  {
    "id": "combo-flow-total",
    "name": "双路气流总流量（组合）",
    "description": "两路 MFC 各 100~300 / 50~150 sccm 波动；输出 TOTAL 是两路之和。",
    "body": "{\"source\":{\"mode\":\"expr\",\"clock\":\"phase\",\"vars\":{\"ch1\":{\"type\":\"uniform\",\"min\":100,\"max\":300,\"resampleMs\":3000},\"ch2\":{\"type\":\"uniform\",\"min\":50,\"max\":150,\"resampleMs\":3000}},\"expr\":\"ch1 + ch2\"}}"
  }
]
