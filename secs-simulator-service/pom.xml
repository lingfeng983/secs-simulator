<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.shimizukenta</groupId>
  <artifactId>secs-simulator-parent</artifactId>
  <version>3.0.1</version>
  <packaging>pom</packaging>

  <name>SECS Simulator (parent)</name>
  <description>SECS/GEM multi-unit simulator: one engine, two runtime shapes (integrated / server)</description>
  <url>https://github.com/kenta-shimizu/secs-simulator</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <modules>
    <module>secs-json</module>
    <module>secs-protocol</module>
    <module>secs-core</module>
    <module>secs-store</module>
    <module>secs-app</module>
    <module>secs-api-http</module>
    <module>secs-runtime</module>
    <module>secs-cli</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>5.11.4</junit.version>
    <archunit.version>1.5.1</archunit.version>
    <asm.version>9.11</asm.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-json</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-protocol</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-store</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-app</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-api-http</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-runtime</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.shimizukenta</groupId><artifactId>secs-cli</artifactId><version>${project.version}</version></dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version><scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version><scope>test</scope>
      </dependency>
      <!-- ArchUnit 用 ASM 解析 class 文件；JDK 25 的 major 69 需要新版本 ASM，否则会静默跳过所有类 -->
      <dependency>
        <groupId>org.ow2.asm</groupId><artifactId>asm</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <!-- 3.0 存储地基（ADR 0017）：配置与运行态台账入 SQLite；版本见 ADR 0017 §3（要求 3.47+） -->
      <dependency>
        <groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId>
        <version>3.49.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        构建前置检查：项目要求 JDK 25（maven.compiler.release 也是 25）。

        没有这道检查时，用 JDK 21 构建的失败信息是
        "Fatal error compiling: 无效的目标发行版: 25"——它不会告诉你
        "是 JDK 版本不对"，只会在编译阶段毫无上下文地失败。
        这里在 validate 阶段就拦下，并直接给出要求版本与当前版本。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>require-jdk-25</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>
                    本项目需要 JDK 25 或更高版本（maven.compiler.release=25）。
                    当前 JDK 不满足要求，请设置 JAVA_HOME 指向 JDK 25 后重试。
                  </message>
                </requireJavaVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <encoding>UTF-8</encoding>
            <!--
              零告警门禁：所有模块一律 -Xlint:all + -Werror。
              过去只有部分模块自带这段配置，"这个子 POM 忘了写"就等于没有门禁。
              -missing-explicit-ctor 关掉：record/隐式构造器会刷屏，且与语义无关。
              冻结模块（secs-protocol）在自己的 POM 里覆盖为"只告警不阻断"，见该模块注释。
            -->
            <compilerArgs>
              <arg>-Xlint:all,-missing-explicit-ctor</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <argLine>-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8</argLine>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
