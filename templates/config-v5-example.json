    "units": [
      {
        "unitId": 1,
        "name": "CH1",
        "injectUnitId": true,
        "svids": [
          { "offset": 1, "slot": "TEMP_PV", "type": "F4", "unit": "C", "decimals": 2, "min": 0, "max": 400 },
          { "offset": 2, "slot": "TEMP_SV", "type": "F4", "unit": "C", "decimals": 2 },
          { "offset": 3, "slot": "HEATER", "type": "F4", "unit": "kW" },
          { "offset": 4, "slot": "PRESS", "type": "F4", "unit": "Torr", "decimals": 3, "min": 0, "max": 10 },
          { "offset": 90, "slot": "UNIT_ID", "type": "U4" }
        ],
        "reports": [
          { "offset": 1, "slot": "STATUS", "svids": ["UNIT_ID", "TEMP_PV", "PRESS"] }
        ],
        "ceids": [
          { "offset": 1, "slot": "PROCESS_START", "reports": ["STATUS"] },
          { "offset": 2, "slot": "TEMP_OVERHEAT", "reports": ["STATUS"] },
          { "offset": 3, "slot": "PROCESS_END", "reports": ["STATUS"] }
        ]
      }
    ]
