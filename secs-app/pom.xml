<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.shimizukenta</groupId>
    <artifactId>secs-simulator-parent</artifactId>
    <version>3.0.1</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>secs-app</artifactId>
  <packaging>jar</packaging>
  <name>SECS Simulator Application</name>
  <description>Use cases: sessions, config, templates, preview, audit</description>

  <dependencies>
      <dependency>
        <groupId>com.shimizukenta</groupId>
        <artifactId>secs-core</artifactId>
      </dependency>
      <dependency>
        <groupId>com.shimizukenta</groupId>
        <artifactId>secs-json</artifactId>
      </dependency>
      <!-- SML 文本层（app.sml）：解析/渲染就是 Secs2 ↔ 文本，没有会话状态，
           所以放在应用层而不是 runtime。协议层是叶子库，app → protocol 不引入循环。 -->
      <dependency>
        <groupId>com.shimizukenta</groupId>
        <artifactId>secs-protocol</artifactId>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
      </dependency>
  </dependencies>

</project>
