<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.shimizukenta</groupId>
    <artifactId>secs-simulator-parent</artifactId>
    <version>2.0.1</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>secs-cli</artifactId>
  <packaging>jar</packaging>
  <name>SECS Simulator CLI</name>
  <description>Headless command line and self-test harness</description>

  <!-- 原生镜像路径：默认指向构建产物，可被 -Dsecs.smoke.exe=... 覆盖 -->
  <properties>
    <secs.smoke.exe>${project.build.directory}/secs-sim.exe</secs.smoke.exe>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.shimizukenta</groupId>
      <artifactId>secs-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>com.shimizukenta</groupId>
      <artifactId>secs-json</artifactId>
    </dependency>
    <!-- M0 尖峰（3.0 设计 §2.3.1）：验证 sqlite-jdbc 的 JNI 本地库在 native-image 里可用；
         M1 存储地基落地后依赖迁往 secs-store，这里保留给 db-spike 冒烟路径 -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <secs.smoke.exe>${secs.smoke.exe}</secs.smoke.exe>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 只有显式 -Pnative 才构建原生镜像，避免日常 verify 变慢 -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>1.1.14</version>
            <configuration>
              <imageName>secs-sim</imageName>
              <mainClass>com.shimizukenta.secssim.cli.CliMain</mainClass>
              <buildArgs>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <buildArg>-Dfile.encoding=UTF-8</buildArg>
                <buildArg>-Os</buildArg>
                <buildArg>-H:IncludeResources=defaults/.*</buildArg>
                <!-- M0 尖峰：sqlite-jdbc 平台本地库要进镜像（运行时由 DbSpike 释放到 work-dir） -->
                <buildArg>-H:IncludeResources=org/sqlite/native/.*</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- mvn -Pnative verify：原生镜像构建后在 failsafe 里跑 NativeRuntimeIT -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.5.2</version>
            <configuration>
              <includes>
                <include>**/NativeRuntimeIT.java</include>
              </includes>
              <systemPropertyVariables>
                <secs.smoke.exe>${project.build.directory}/secs-sim.exe</secs.smoke.exe>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <id>native-e2e</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
