<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.shimizukenta</groupId>
    <artifactId>secs-simulator-parent</artifactId>
    <version>3.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>secs-protocol</artifactId>
  <packaging>jar</packaging>
  <name>SECS Protocol</name>
  <description>HSMS-SS / SECS-I / SECS-II / SML / GEM message layer (derived from secs4java8)</description>

  <dependencies>
      <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            冻结模块（源自 secs4java8，229 个类保持原样）：只观察告警，不用 -Werror 阻断。
            需要改本模块时，先按父 POM 的零告警门禁自查后再改这里。
          -->
          <compilerArgs>
            <arg>-Xlint:all,-missing-explicit-ctor</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
